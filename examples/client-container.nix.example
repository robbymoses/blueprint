# Save a private copy as ~/client-containers/clients/client-a/default.nix and
# import it from that client's standalone flake. The host flake never imports
# this file or learns the client name.
{ pkgs, ... }:

{
  networking.hostName = "client-a";

  environment.systemPackages = with pkgs; [
    firefox
  ];

  # Twingate writes enrollment state into the persistent guest root. After
  # creating the container, use `sudo nixos-container root-login client-a`
  # and run `twingate setup`.
  networking.useHostResolvConf = false;
  services.twingate.enable = true;
}
